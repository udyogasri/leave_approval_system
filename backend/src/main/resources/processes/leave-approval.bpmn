<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0d45oq3" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="leaveApprovalProcess" name="Leave Approval Process" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="StartEvent_1" name="Leave Request Received">
      <bpmn:outgoing>Flow_start_to_save</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="saveLeaveTask" name="Save Leave Request" camunda:delegateExpression="${saveLeaveDelegate}">
      <bpmn:incoming>Flow_start_to_save</bpmn:incoming>
      <bpmn:outgoing>Flow_save_to_manager</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="managerApproval" name="Manager Approval" camunda:assignee="manager">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="approved" label="Approve Leave" type="boolean" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_save_to_manager</bpmn:incoming>
      <bpmn:outgoing>Flow_manager_to_gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_decision" name="Approved?">
      <bpmn:incoming>Flow_manager_to_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_to_approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="approveLeaveTask" name="Approve Leave" camunda:delegateExpression="${approveLeaveDelegate}">
      <bpmn:incoming>Flow_to_approve</bpmn:incoming>
      <bpmn:outgoing>Flow_approve_to_merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="rejectLeaveTask" name="Reject Leave" camunda:delegateExpression="${rejectLeaveDelegate}">
      <bpmn:incoming>Flow_to_reject</bpmn:incoming>
      <bpmn:outgoing>Flow_reject_to_merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="notifyEmployeeService" name="Notify Employee" camunda:delegateExpression="${notifyEmployeeDelegate}">
      <bpmn:incoming>Flow_approve_to_merge</bpmn:incoming>
      <bpmn:incoming>Flow_reject_to_merge</bpmn:incoming>
      <bpmn:outgoing>Flow_notify_to_task</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="notifyEmployee" name="Acknowledge Notification" camunda:assignee="employee">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="acknowledged" label="I have read the decision" type="boolean" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_notify_to_task</bpmn:incoming>
      <bpmn:outgoing>Flow_task_to_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1" name="Process Complete">
      <bpmn:incoming>Flow_task_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_to_save" sourceRef="StartEvent_1" targetRef="saveLeaveTask" />
    <bpmn:sequenceFlow id="Flow_save_to_manager" sourceRef="saveLeaveTask" targetRef="managerApproval" />
    <bpmn:sequenceFlow id="Flow_manager_to_gateway" sourceRef="managerApproval" targetRef="Gateway_decision" />
    <bpmn:sequenceFlow id="Flow_to_approve" sourceRef="Gateway_decision" targetRef="approveLeaveTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_to_reject" sourceRef="Gateway_decision" targetRef="rejectLeaveTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_approve_to_merge" sourceRef="approveLeaveTask" targetRef="notifyEmployeeService" />
    <bpmn:sequenceFlow id="Flow_reject_to_merge" sourceRef="rejectLeaveTask" targetRef="notifyEmployeeService" />
    <bpmn:sequenceFlow id="Flow_notify_to_task" sourceRef="notifyEmployeeService" targetRef="notifyEmployee" />
    <bpmn:sequenceFlow id="Flow_task_to_end" sourceRef="notifyEmployee" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="leaveApprovalProcess">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="126" y="195" width="88" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="saveLeaveTask_di" bpmnElement="saveLeaveTask">
        <dc:Bounds x="240" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="managerApproval_di" bpmnElement="managerApproval">
        <dc:Bounds x="400" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_decision_di" bpmnElement="Gateway_decision" isMarkerVisible="true">
        <dc:Bounds x="565" y="145" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="625" y="163" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approveLeaveTask_di" bpmnElement="approveLeaveTask">
        <dc:Bounds x="680" y="50" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rejectLeaveTask_di" bpmnElement="rejectLeaveTask">
        <dc:Bounds x="680" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notifyEmployeeService_di" bpmnElement="notifyEmployeeService">
        <dc:Bounds x="840" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notifyEmployee_di" bpmnElement="notifyEmployee">
        <dc:Bounds x="1000" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1162" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1141" y="195" width="79" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_to_save_di" bpmnElement="Flow_start_to_save">
        <di:waypoint x="188" y="170" />
        <di:waypoint x="240" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_save_to_manager_di" bpmnElement="Flow_save_to_manager">
        <di:waypoint x="340" y="170" />
        <di:waypoint x="400" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_manager_to_gateway_di" bpmnElement="Flow_manager_to_gateway">
        <di:waypoint x="500" y="170" />
        <di:waypoint x="565" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_approve_di" bpmnElement="Flow_to_approve">
        <di:waypoint x="590" y="145" />
        <di:waypoint x="590" y="90" />
        <di:waypoint x="680" y="90" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_reject_di" bpmnElement="Flow_to_reject">
        <di:waypoint x="590" y="195" />
        <di:waypoint x="590" y="280" />
        <di:waypoint x="680" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_approve_to_merge_di" bpmnElement="Flow_approve_to_merge">
        <di:waypoint x="780" y="90" />
        <di:waypoint x="890" y="90" />
        <di:waypoint x="890" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_reject_to_merge_di" bpmnElement="Flow_reject_to_merge">
        <di:waypoint x="780" y="280" />
        <di:waypoint x="890" y="280" />
        <di:waypoint x="890" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_notify_to_task_di" bpmnElement="Flow_notify_to_task">
        <di:waypoint x="940" y="170" />
        <di:waypoint x="1000" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_task_to_end_di" bpmnElement="Flow_task_to_end">
        <di:waypoint x="1100" y="170" />
        <di:waypoint x="1162" y="170" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
